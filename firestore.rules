rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validHabit(d) {
      return d.keys().hasOnly([
          'name', 'icon', 'category', 'frequency', 'target', 'linkedWorkout',
          'startDate', 'note', 'archived', 'order', 'createdAt', 'updatedAt'
        ])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.icon in ['drop', 'book', 'bolt', 'moon', 'pen', 'dots']
        && d.category in ['kesehatan', 'belajar', 'olahraga', 'kerja', 'lainnya']
        && d.frequency is map
        && d.frequency.type in ['daily', 'days', 'weekly']
        && d.linkedWorkout is bool
        && d.archived is bool
        && isDateKey(d.startDate)
        && d.note is string && d.note.size() <= 200;
    }

    function validLog(d) {
      return d.keys().hasOnly(['habitId', 'date', 'done', 'value', 'updatedAt'])
        && d.habitId is string
        && isDateKey(d.date)
        && d.done is bool;
    }

    function validExercise(d) {
      return d.keys().hasOnly(['name', 'muscleGroup', 'archived', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.muscleGroup is string && d.muscleGroup.size() <= 30
        && d.archived is bool;
    }

    function validSession(d) {
      return d.keys().hasOnly(['date', 'durationMin', 'note', 'entries', 'createdAt', 'updatedAt'])
        && isDateKey(d.date)
        && (d.durationMin == null || (d.durationMin is number && d.durationMin > 0 && d.durationMin <= 1440))
        && d.note is string && d.note.size() <= 200
        && d.entries is list && d.entries.size() >= 1 && d.entries.size() <= 30;
    }

    function validBodyPart(d) {
      return d.keys().hasOnly(['name', 'order', 'active'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.order is number
        && d.active is bool;
    }

    function validMeasurement(d) {
      return d.keys().hasOnly(['bodyPartId', 'date', 'valueCm', 'updatedAt'])
        && d.bodyPartId is string
        && isDateKey(d.date)
        && d.valueCm is number && d.valueCm > 0 && d.valueCm <= 500;
    }

    function validBodyWeight(d, id) {
      return d.keys().hasOnly(['date', 'valueKg', 'updatedAt'])
        && isDateKey(d.date) && d.date == id
        && d.valueKg is number && d.valueKg > 0 && d.valueKg <= 700;
    }

           // Token notifikasi push, satu dokumen per perangkat (id dokumen = token).
       function validPushToken(d) {
         return d.keys().hasOnly(['token', 'platform', 'updatedAt'])
           && d.token is string && d.token.size() > 20 && d.token.size() <= 4096
           && d.platform is string && d.platform.size() <= 20;
       }


    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /habits/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validHabit(request.resource.data);
      }

      match /habitLogs/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validLog(request.resource.data);
      }

      match /exercises/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validExercise(request.resource.data);
      }

      match /workoutSessions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSession(request.resource.data);
      }

      match /bodyParts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBodyPart(request.resource.data);
      }

      match /measurements/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMeasurement(request.resource.data);
      }
         match /pushTokens/{id} {
           allow read, delete: if isOwner(uid);
           allow create, update: if isOwner(uid) && validPushToken(request.resource.data);
         }
         
      match /bodyWeights/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBodyWeight(request.resource.data, id);
      }
    }
  }
}